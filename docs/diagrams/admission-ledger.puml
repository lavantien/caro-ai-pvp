@startuml admission-ledger
!include common.iuml
title Machine admission, full capacity or a clear failure

participant "ledger\ncoresFree = MachineCores,\nttFree = MachineTTBudgetBytes" as ledger
participant "room creation" as room
participant "bot turn" as turn
participant "ponder lane" as lane

room -> room : Read the machine's available physical memory
alt reserve + bot TT bytes fit
  room -> ledger : Acquire each bot seat's TT bytes at game start
  alt TT bytes still in the budget
    ledger --> room : Granted
  else over budget
    ledger --> room : Reject with machine-busy
  end
else memory cannot fund the room
  room -> room : Reject with server-resources-full
end
turn -> ledger : Acquire the seat's search cores,\nwait up to AdmissionWaitMaxMs, no partial grant
alt cores granted in time
  turn -> turn : Search runs at full tier capacity,\ncores release at the answer
else timed out
  turn -> turn : The room fails loudly with admission-timeout
end
lane -> ledger : Try acquire tier.PonderThreads cores, no wait
alt cores free
  lane -> lane : Ponder runs at the tier's full width,\nreleased on stop, adoption, or disarm
else busy
  lane -> lane : The turn runs ponder off, never a narrower engine
end
ledger -> ledger : TT bytes release when the engines close
note over ledger
  Tournament rounds admit through the same ledger,
  the run gate bounds each round by the worst room
  pair peak of the picked tiers
end note
@enduml
