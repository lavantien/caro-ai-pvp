@startuml pwa-shell
!include common.iuml
left to right direction
title Pwa shell, offline boundary

actor "Browser" as browser
component "Page surface\nserver rendered html, htmx" as pages
component "Service worker" as sw
package "Cache storage" as cache {
  component "Shell cache\nstylesheet, scripts, icons,\noffline page" as shell
}
component "Server" as server
component "Event stream\n/api/rooms/{id}/events" as sse

browser --> pages : Navigate
pages --> sw : Fetch passes through
sw --> shell : Shell assets, cache first
sw --> server : Navigation, network first
sw ..> cache : Install precaches the shell,\nactivate drops older cache versions
sw --> server : Offline fallback page\nwhen the network fails
browser --> sse : Live updates, always network
sw ..x sse : The /api/ prefix is never\nanswered from the worker
note bottom of server
  The server is authoritative,
  no offline gameplay, the api and
  the event stream bypass the worker
end note
@enduml
