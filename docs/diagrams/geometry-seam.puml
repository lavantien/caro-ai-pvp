@startuml geometry-seam
!include common.iuml
left to right direction
title Geometry seam, 2 boards one architecture

component "config.Variants\nsquare 16x16, hex side 12" as variants
component "geom.Geometry\ndescriptor\nstride, cells, words, region mask,\ndirections with clear masks,\nneighbors, center, opening min,\ncell names and parsing" as geom
component "rules\nBoard, legality,\nwin scan over the directions" as rules
component "pattern\nWindow extraction,\ncells off region map to Off" as pattern
component "engine\nBitmask words and loops\nbound by the geometry" as engine
component "vcf\nSolver threat walks" as vcf
component "server\nBoard rendering,\ncell names, variant routing" as server

variants --> geom : Square(16) and Hex(12)
geom --> rules
geom --> pattern
geom --> engine
geom --> vcf
geom --> server
note bottom of server
  The opening book is a square
  artifact, the hexagon ships
  bookless
end note
@enduml
