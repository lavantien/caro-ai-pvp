@startuml engine-searcher-stack
!include common.iuml
left to right direction
title Searcher stack per tier seat

rectangle "Room bot worker" as room
rectangle "Ponder lane\nown goroutine, 1 buffer commands" as lane
package "Searcher chain (newBotSearcherFor)" {
  component "bookSearcher\nSquare artifact only,\nprobe under BookMaxPly,\n[BOOK] reply" as book
  component "solverSearcher\nVCF pass then VCT pass,\nsolver budget share of the grant,\nskipped under SolverMinGrantMs" as solver
  component "tierSearcher (cores > 1)\nSMP, TieredEval weights" as smp
  component "singleSearcher (cores = 1)\nSingle engine" as single
}
package "Engine core" {
  component "SMP workers\n1 locked thread per core,\nparked between searches" as workers
  component "Single engine" as eng
  component "Transposition table\nDirect mapped, generation bump,\nshared lockless" as tt
  component "Killer table" as killers
}
room --> book
book --> solver : Past the ply bound\nor no hit
solver --> smp : No proof, rest of grant
solver --> single : No proof, rest of grant
smp --> workers
single --> eng
workers --> tt
workers --> killers
eng --> tt
eng --> killers
room --> lane : Arm after the bot move,\nponder width = tier.PonderThreads
lane ..> solver : StartPonder: solver passes run off lane\nunder a stoppable deadline,\nproof adopted on StopPonder
note bottom of solver
  A proof returns [VCF] or [VCT]
  and ends the turn without a search
end note
@enduml
