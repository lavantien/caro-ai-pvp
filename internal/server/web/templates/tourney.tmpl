{{define "title"}}bot tournament - caro{{end}}
{{define "content"}}
<section aria-label="tournament setup">
<h2>bot tournament</h2>
{{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
{{if .Admin}}
<form class="tourneyform" method="post" action="/tourney">
<fieldset>
<legend>setup</legend>
<div class="field">time control
{{template "seg" .SegTC}}
</div>
<div class="field">best of
{{template "seg" .SegBO}}
</div>
<label>start rating
<input name="rating" type="number" value="{{.StartRating}}">
</label>
<div class="field">parallel matches
{{template "seg" .SegParallel}}
</div>
<label>participants
<select name="count">{{range .CountOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>
</label>
<div class="field">board
{{template "seg" .SegVariant}}
</div>
<fieldset class="roster">
<legend>roster, the first rows play</legend>
{{range .Rows}}
<label class="botname">bot {{.N}}
<input name="name{{.N}}" maxlength="{{$.MaxNameLen}}" value="{{.Name}}">
</label>
<div class="field">tier
{{template "seg" .SegTier}}
</div>
{{end}}
</fieldset>
<button>start tournament</button>
</fieldset>
</form>
{{else}}<p class="empty">tournaments are started by the admin account.</p>{{end}}
</section>
<section aria-label="tournament runs">
<h2>runs</h2>
{{if .Runs}}<ul class="tourney-runs">
{{range .Runs}}<li class="tourney-run"><a href="/tourney/run/{{.ID}}">run <span class="mono">{{.ID}}</span></a>
<span class="meta"><span>{{.When}}</span><span class="chip">{{.TC}}</span><span class="chip">{{.BO}}</span>{{if ne .Variant "square"}}<span class="chip">{{.Variant}}</span>{{end}}<span class="chip">{{.State}}</span><span>{{.Roster}}</span><span class="score">{{.Leader}}</span></span>
</li>
{{end}}</ul>{{else}}<p class="empty">no tournaments yet.</p>{{end}}
</section>
{{end}}
