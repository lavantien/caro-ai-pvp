{{define "lobbylist"}}
{{if .Rooms}}<ul class="liveboards">
{{range .Rooms}}<li><div class="livecard">
<div class="who-vs">{{template "lobbyseat" .Red}} vs {{template "lobbyseat" .Blue}}</div>
<a class="watch" href="/rooms/{{.ID}}">
<span class="meta"><span class="chip">{{.Mode}}</span><span class="chip">{{.TC}}</span><span class="chip">{{.BO}}</span><span class="chip">{{template "vglyph" .Variant}} {{.Variant}}</span><span class="chip">{{.Status}}</span>{{if .Spectators}}<span class="chip">{{.Spectators}} watching</span>{{end}}<span class="chip" title="room {{.ID}}">room <span class="mono">{{.ShortID}}</span></span></span>
{{template "board-grid" .}}
<span class="meta">{{.MoveCount}} stones</span>
</a>
{{if .CanJoin}}<form class="inline joinrow" method="post" action="/lobby/{{.ID}}/join"><button>join</button></form>{{end}}
</div></li>
{{end}}</ul>{{else}}<p class="empty">no live rooms</p>{{end}}
{{end}}
{{define "lobbyseat"}}{{if .Profile}}<a href="{{.Profile}}">{{.Name}}</a>{{else}}{{.Name}}{{end}}{{if .Tier}} <span class="chip">{{.Tier}}</span>{{end}}{{end}}
{{define "quickstart"}}
{{if .Me}}
<form class="actions quick" method="post" action="/rooms">
<fieldset>
<legend>quick start</legend>
<input type="hidden" name="origin" value="lobby">
<div class="field">time control
{{template "seg" .SegTC}}
</div>
<div class="field">best of
{{template "seg" .SegBO}}
</div>
<label>opponent<select name="bot">{{range .BotOptions}}<option value="{{.Value}}">{{.Label}}</option>{{end}}</select></label>
<div class="field">board
{{template "seg" .SegVariant}}
</div>
<button>play</button>
</fieldset>
</form>
{{else}}<p class="guestnote"><a href="/login">login / create</a> to start a game.</p>{{end}}
{{end}}
{{define "title"}}lobby - caro{{end}}
{{define "pagestyle"}}{{template "board-css"}}<style>
.livecard a.watch { display: grid; gap: .15rem; text-decoration: none; color: inherit }
.livecard .joinrow { margin-top: var(--space-1) }
.quick { margin: 0 0 var(--space-3) }
</style>{{end}}
{{define "content"}}
<section aria-label="lobby">
<h2>lobby</h2>
{{if .JoinError}}<p class="error" role="alert">{{.JoinError}}</p>{{end}}
{{template "quickstart" .}}
<div id="lobby" hx-get="/partials/lobby" hx-trigger="every {{.PollMs}}ms" hx-swap="innerHTML">
{{template "lobbylist" .}}
</div>
</section>
{{end}}
