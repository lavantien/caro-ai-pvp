{{define "roomslist"}}
{{if .Live}}<p class="tourneynow"><a href="/tourney/run/{{.Live.RunID}}">a bot tournament is live</a>, series {{.Live.Done}}/{{.Live.Total}} settled</p>
{{end}}{{if .Rooms}}<ul class="rooms">
{{range .Rooms}}<li class="room"><a href="/rooms/{{.ID}}" title="room {{.ID}}">room <span class="mono">{{.ShortID}}</span></a>
<span class="meta"><span class="chip">{{.TC}}</span><span class="chip">{{.BO}}</span><span class="chip" title="{{.Variant}}">{{template "vglyph" .Variant}}</span><span class="chip">{{.State}}</span><span title="{{.Host}} / {{.Guest}}"><span class="vname">{{disp .Host}}</span> vs <span class="vname">{{disp .Guest}}</span></span>{{if .ShowScore}}<span class="score">{{.Score}}</span>{{end}}</span>
</li>
{{end}}</ul>{{else}}<p class="empty">no live rooms</p>{{end}}{{end}}
